{
  "name": "dsh-amdl-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Download NetEase playlists or Apple Music links as local ALAC files through amdl and wrapper-lite.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "lib", "tools", "vendor", "locale", "icon.svg"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "capabilities": ["subprocess", "tools:register"]
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
